# Application
APP_ENV=development
HTTP_PORT=8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s

# Protected internal-service Bearer /metrics; no unauthenticated mode
METRICS_ENABLED=true
METRICS_COLLECT_INTERVAL=15s
METRICS_COLLECT_TIMEOUT=2s

# PostgreSQL (Docker Compose)
POSTGRES_USER=wagering
POSTGRES_PASSWORD=wagering
POSTGRES_DB=wagering
POSTGRES_PORT=5432

# Application database connection
DATABASE_URL=postgres://wagering:wagering@localhost:5432/wagering?sslmode=disable

# Connection pool
DB_MAX_CONNS=10
DB_MIN_CONNS=1
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_CONNECT_TIMEOUT=5s
DB_HEALTH_TIMEOUT=2s

# Database-only pending-reference worker
PENDING_REFERENCE_POLL_INTERVAL=1s
PENDING_REFERENCE_BASE_DELAY=1s
PENDING_REFERENCE_MAX_DELAY=1m
PENDING_REFERENCE_MAX_ATTEMPTS=10
PENDING_REFERENCE_TTL=15m
PENDING_REFERENCE_BATCH_SIZE=50

# SQS FIFO / LocalStack (dummy local credentials)
SQS_ENABLED=true
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_QUEUE_NAME=wager-transactions.fifo
SQS_QUEUE_URL=
SQS_DLQ_NAME=wager-transactions-dlq.fifo
SQS_CONSUMER_NAME=wager-financial-v1
SQS_WAIT_SECONDS=20
SQS_VISIBILITY_SECONDS=90
SQS_MAX_MESSAGES=10
SQS_CONCURRENCY=4
SQS_PROCESSING_TIMEOUT=5s
SQS_MAX_RECEIVE_COUNT=5
LOCALSTACK_PORT=4566

# Transactional Outbox (separate outgoing domain-event FIFO)
OUTBOX_PUBLISHER_ENABLED=true
EVENT_QUEUE_NAME=wager-events.fifo
EVENT_QUEUE_URL=
OUTBOX_POLL_INTERVAL=1s
OUTBOX_BATCH_SIZE=10
OUTBOX_BASE_RETRY_DELAY=1s
OUTBOX_MAX_RETRY_DELAY=1m
OUTBOX_CLAIM_DURATION=30s
OUTBOX_PUBLISH_TIMEOUT=5s
OUTBOX_STORE_TIMEOUT=3s

# OIDC access-token validation (backend does not need a client secret)
OIDC_ENABLED=true
OIDC_ISSUER_URL=http://localhost:8081/realms/jungle-gaming
OIDC_AUDIENCE=wagering-api
OIDC_HTTP_TIMEOUT=5s

# Keycloak dev-only, separate embedded H2 database, local credentials only
KEYCLOAK_PORT=8081
KEYCLOAK_MANAGEMENT_PORT=9090
KEYCLOAK_ADMIN=local-admin
KEYCLOAK_ADMIN_PASSWORD=local-dev-admin-password
